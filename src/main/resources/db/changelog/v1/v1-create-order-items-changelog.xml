<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="v1-3" author="ramenchyk-katsiaryna">
    <createTable tableName="order_items">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="order_id" type="bigint">
        <constraints
          nullable="false"
          foreignKeyName="fk_order_items_order"
          references="orders(id)"
        />
      </column>
      <column name="item_id" type="bigint">
        <constraints
          nullable="false"
          foreignKeyName="fk_order_items_item"
          references="items(id)"
        />
      </column>
      <column name="quantity" type="int">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createIndex tableName="order_items" indexName="idx_order_items_order_id">
      <column name="order_id" />
    </createIndex>
    <createIndex tableName="order_items" indexName="idx_order_items_item_id">
      <column name="item_id" />
    </createIndex>

    <addUniqueConstraint tableName="order_items" columnNames="order_id, item_id" constraintName="uc_order_item"/>

    <sql>
        ALTER TABLE order_items
        ADD CONSTRAINT chk_order_items_quantity_positive CHECK (quantity > 0);
    </sql>

    <rollback>
      <sql>
        ALTER TABLE order_items
        DROP CONSTRAINT chk_order_items_quantity_positive;
      </sql>
      <dropTable tableName="order_items" cascadeConstraints="true"/>
    </rollback>

  </changeSet>
</databaseChangeLog>